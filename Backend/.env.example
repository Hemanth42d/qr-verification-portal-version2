PORT=5000
MONGODB_URI=mongodb://localhost:27017/cert-portal
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Google Drive — Option 1: Service Account (recommended)
# Place your service-account.json file in the Backend folder
# Then set the folder ID of the Drive folder you shared with the service account email
# Open the shared folder in Drive → grab the ID from the URL: drive.google.com/drive/folders/<THIS_ID>
GOOGLE_DRIVE_FOLDER_ID=your_shared_folder_id_here

# Google Drive OAuth2 — needed for uploading files as your personal account
# 1. Create OAuth2 credentials at https://console.cloud.google.com/apis/credentials
# 2. Run: node get-drive-token.js to get the refresh token
GOOGLE_DRIVE_CLIENT_ID=your_client_id
GOOGLE_DRIVE_CLIENT_SECRET=your_client_secret
GOOGLE_DRIVE_REFRESH_TOKEN=your_refresh_token

# Gmail SMTP
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Local dev
FRONTEND_URL=http://localhost:5173

# For Render deployment, set this to your Vercel frontend URL, e.g.:
# FRONTEND_URL=https://your-app.vercel.app
